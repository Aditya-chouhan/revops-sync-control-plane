APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/revops_sync
AUTO_CREATE_SCHEMA=false
WORKFLOW_API_KEY=
FIXTURE_PATH=data/synthetic/crm_accounts.json

# External delivery is impossible unless the global and matching provider
# switches are true. Never commit real credentials.
LIVE_INTEGRATIONS_ENABLED=false
HUBSPOT_LIVE_ENABLED=false
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_BASE_URL=https://api.hubapi.com
SALESFORCE_LIVE_ENABLED=false
SALESFORCE_ACCESS_TOKEN=
SALESFORCE_INSTANCE_URL=
SALESFORCE_API_VERSION=v65.0
CONNECTOR_TIMEOUT_SECONDS=20
CONNECTOR_MAX_RETRIES=4
